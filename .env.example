# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Restaurant Social Platform
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-Side Secrets
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=your_database_connection_string
TOKEN_ENCRYPTION_KEY=your_64_character_hex_encryption_key
ENCRYPTION_KEY=your_64_character_hex_encryption_key
CRON_SECRET=your_cron_secret

# AI Providers
AI_PROVIDER=disabled
AI_API_KEY=your_ai_provider_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Instagram API with Instagram Login (Preferred)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Legacy Meta Fallbacks (Backwards compatible)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
META_GRAPH_API_VERSION=v20.0


# Google Business Profile
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# TikTok
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_WEBHOOK_VERIFY_TOKEN=your_tiktok_webhook_verify_token